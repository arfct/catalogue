<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% if build.commit %}<meta name="generator" content="Eleventy, {{ build.commit }}">{% endif %}

{# Link-preview metadata (see the README's "Link previews"). Everything is
   computed by the linkPreview filter in .eleventy.js; Nunjucks escapes it. #}
{% set lp = page | linkPreview %}
<title>{{ lp.documentTitle }}</title>
<meta name="description" content="{{ lp.description }}">
{% if lp.url %}<link rel="canonical" href="{{ lp.url }}">{% endif %}

<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ lp.title }}">
<meta property="og:description" content="{{ lp.description }}">
<meta property="og:type" content="{{ lp.type }}">
{% if lp.url %}<meta property="og:url" content="{{ lp.url }}">{% endif %}
{% if lp.image %}
<meta property="og:image" content="{{ lp.image.url }}">
<meta property="og:image:type" content="{{ lp.image.type }}">
<meta property="og:image:width" content="{{ lp.image.width }}">
<meta property="og:image:height" content="{{ lp.image.height }}">
<meta property="og:image:alt" content="{{ lp.image.alt }}">
{% endif %}

<meta name="twitter:card" content="{{ 'summary_large_image' if (lp.image or lp.xCard) else 'summary' }}">
<meta name="twitter:title" content="{{ lp.title }}">
<meta name="twitter:description" content="{{ lp.description }}">
{# The composed card for X. No twitter:image is served by default, so every
   other crawler takes og:image; _worker.js renames these to twitter:* for
   Twitterbot alone (see the README's "Link previews"). #}
{% if lp.xCard %}
<meta name="catalogue:x-image" content="{{ lp.xCard.url }}">
<meta name="catalogue:x-image:alt" content="{{ lp.xCard.alt }}">
<meta name="catalogue:x-image:width" content="{{ lp.xCard.width }}">
<meta name="catalogue:x-image:height" content="{{ lp.xCard.height }}">
{% endif %}

{% if lp.icon %}
<link rel="icon" type="image/png" href="{{ lp.icon }}">
<link rel="apple-touch-icon" href="{{ lp.icon }}">
{% endif %}
{% if lp.themeColor %}<meta name="theme-color" content="{{ lp.themeColor }}">{% endif %}
{# iMessage shows the description, and the icon beside the image, only for
   pages that look like a social post: og:type article plus this ActivityPub
   alternate (an empty href is enough). Other platforms ignore the link. #}
{% if lp.postLayout %}<link rel="alternate" type="application/activity+json" href="">{% endif %}

{# Inline so the opt-in is in place the moment Chrome renders the new page;
   from main.css it was sometimes not yet applied, and the zoom-in skipped. #}
<style>@view-transition { navigation: auto; }</style>
<link rel="stylesheet" href="/styles/main.css">
<link rel="stylesheet" href="/styles/custom.css">
<style>:root { --accent: {{ site.accent_color | default("#1a1a1a") }}; }</style>

{# Google Fonts, per page. A list of css2 family specs, e.g.
   fonts: ["Alegreya:ital,wght@0,400..900;1,400..900"] #}
{% if fonts %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{% for family in fonts %}
<link href="https://fonts.googleapis.com/css2?family={{ family }}&display=swap" rel="stylesheet">
{% endfor %}
{% endif %}

{# A bundled page script, from scripts/pages/<name>.js. Bundled by esbuild
   because browsers cannot resolve bare module specifiers like "three". #}
{% if script %}<script type="module" src="/js/{{ script }}.js"></script>{% endif %}

<!-- Prefetch same-origin pages on hover so cross-document view transitions
     land render-ready in Chrome (Safari/Arc already preload). -->
<script type="speculationrules">
{
  "prefetch": [
    { "source": "document", "where": { "href_matches": "/*" }, "eagerness": "moderate" }
  ]
}
</script>
