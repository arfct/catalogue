---
layout: layout.njk
permalink: "{{ site.catalog_path }}"
---
<div class="index-hero">
  <h1 class="index-hero__name">{{ site.title }}</h1>
  {% if site.description %}
    <p class="index-hero__desc">{{ site.description }}</p>
  {% endif %}
</div>

{% set grouped = collections.entryGroups.length > 1 %}
{% for group in collections.entryGroups %}
<section class="entry-group entry-group--{{ group.id }}">
  {% if grouped %}<h2 class="entry-group__label">{{ group.label }}</h2>{% endif %}
  <div class="entry-grid">
    {% for entry in group.entries %}
      {% set firstMedia = entry.data.media[0] %}
      <a href="{{ entry.url }}" class="entry-card">
        {% if firstMedia %}
          <div class="entry-card__thumb" style="view-transition-name: entry-{{ entry.fileSlug }}">
            <img
              src="{{ firstMedia.src | mediaUrl }}"
              alt="{{ firstMedia.alt or entry.data.title }}"
              loading="lazy"
            >
          </div>
        {% endif %}
        {% set status = entry.data.status or "wip" %}
        <div class="entry-card__meta">
          <ul class="tag-line entry-card__line">
            <li class="entry-card__date">{{ entry.data.date | entryDate }}</li>
            {% if status != "released" %}<li class="entry-card__status entry-card__status--{{ status }}">{{ status | statusLabel }}</li>{% endif %}
            {% for tag in entry.data.tags %}
              <li>{{ tag | tagLabel }}</li>
            {% endfor %}
          </ul>
          <h2 class="entry-card__title">{{ entry.data.title }}</h2>
          {% if entry.data.icon_macos %}<img class="entry-card__icon app-icon app-icon--macos" src="{{ entry.data.icon_macos | mediaUrl }}" alt="" width="40" height="40" loading="lazy">{% elif entry.data.icon %}<img class="entry-card__icon app-icon app-icon--{{ entry.data.icon_shape or 'squircle' }}" src="{{ entry.data.icon | mediaUrl }}" alt="" width="40" height="40" loading="lazy">{% endif %}
          {% set blurb = entry | cardSummary %}
          {% if blurb %}<p class="entry-card__desc">{{ blurb }}</p>{% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</section>
{% endfor %}
